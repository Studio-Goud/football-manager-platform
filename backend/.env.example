# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/football_manager"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Football API (RapidAPI - API-Football)
FOOTBALL_API_KEY="your-rapidapi-key"
FOOTBALL_API_HOST="v3.football.api-sports.io"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Adyen (alternative payment)
ADYEN_API_KEY="your_adyen_api_key"
ADYEN_MERCHANT_ACCOUNT="YourMerchantAccount"

# KYC (Sumsub)
SUMSUB_APP_TOKEN="your_sumsub_app_token"
SUMSUB_SECRET_KEY="your_sumsub_secret"

# Email (SendGrid)
SENDGRID_API_KEY="SG.your_key"
FROM_EMAIL="noreply@footballmanager.pro"
