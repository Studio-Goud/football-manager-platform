generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER")
  url      = env("DATABASE_URL")
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password_hash   String
  username        String   @unique
  balance_credits Decimal  @default(0)
  balance_pending Decimal  @default(0)
  tier            String   @default("BRONZE")
  kyc_status      String   @default("PENDING")
  kyc_level       Int      @default(0)
  is_admin        Boolean  @default(false)
  is_suspended    Boolean  @default(false)
  date_of_birth   DateTime?
  country         String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  last_active     DateTime @default(now())

  teams              Team[]
  transactions       Transaction[]
  listings           MarketplaceListing[]
  bids               MarketplaceBid[]
  powerups           UserPowerup[]
  sessions           UserSession[]
  achievements       UserAchievement[]
  responsible_gaming ResponsibleGaming?
  duels_as_challenger  Duel[]                @relation("DuelChallenger")
  duels_as_opponent    Duel[]                @relation("DuelOpponent")
  private_league_memberships PrivateLeagueMember[]
  league_messages            LeagueMessage[]
  sponsors                   UserSponsor[]
  notifications              Notification[]

  @@map("users")
}

model Season {
  id               Int      @id @default(autoincrement())
  name             String
  competition      String
  start_date       DateTime
  end_date         DateTime
  entry_fee_min    Decimal
  entry_fee_max    Decimal
  total_pot        Decimal  @default(0)
  platform_fee_pct Decimal  @default(20)
  status           String   @default("UPCOMING")
  created_at       DateTime @default(now())

  gameweeks Gameweek[]
  teams     Team[]

  @@map("seasons")
}

model Gameweek {
  id         Int      @id @default(autoincrement())
  season_id  Int
  number     Int
  deadline   DateTime
  start_date DateTime
  end_date   DateTime
  status     String   @default("UPCOMING")

  season         Season         @relation(fields: [season_id], references: [id])
  matches        Match[]
  team_gameweeks TeamGameweek[]
  duels          Duel[]

  @@map("gameweeks")
}

model League {
  id          Int      @id @default(autoincrement())
  name        String
  country     String
  external_id String   @unique
  logo_url    String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  players Player[]

  @@map("leagues")
}

model Player {
  id                  Int      @id @default(autoincrement())
  external_id         String   @unique
  name                String
  display_name        String
  club                String
  club_id             Int
  position            String
  nationality         String?
  photo_url           String?
  league_id           Int?
  league_external_id  String?
  price               Decimal  @default(5)
  form                Decimal  @default(5)
  total_points        Decimal  @default(0)
  availability        String   @default("AVAILABLE")
  injury_return       DateTime?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  league             League?            @relation(fields: [league_id], references: [id])
  team_players       TeamPlayer[]
  match_performances MatchPerformance[]
  listings           MarketplaceListing[]
  price_history      PlayerPriceHistory[]

  @@map("players")
}

model Team {
  id                     String   @id @default(uuid())
  user_id                String
  season_id              Int
  name                   String
  formation              String   @default("4-4-2")
  tactic_style           String   @default("BALANCED")
  captain_player_id      Int?
  vice_captain_player_id Int?
  total_points           Decimal  @default(0)
  entry_fee              Decimal
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  user      User           @relation(fields: [user_id], references: [id])
  season    Season         @relation(fields: [season_id], references: [id])
  players   TeamPlayer[]
  gameweeks TeamGameweek[]

  @@map("teams")
}

model TeamPlayer {
  id              Int      @id @default(autoincrement())
  team_id         String
  player_id       Int
  slot_position   String
  is_captain      Boolean  @default(false)
  is_vice_captain Boolean  @default(false)
  purchase_price  Decimal
  added_at        DateTime @default(now())

  team   Team   @relation(fields: [team_id], references: [id])
  player Player @relation(fields: [player_id], references: [id])

  @@map("team_players")
}

model TeamGameweek {
  id           Int     @id @default(autoincrement())
  team_id      String
  gameweek_id  Int
  points       Decimal @default(0)
  rank         Int?
  prize_amount Decimal @default(0)

  team     Team     @relation(fields: [team_id], references: [id])
  gameweek Gameweek @relation(fields: [gameweek_id], references: [id])

  @@unique([team_id, gameweek_id])
  @@map("team_gameweeks")
}

model Match {
  id           Int      @id @default(autoincrement())
  external_id  String   @unique
  gameweek_id  Int
  home_team    String
  home_team_id Int
  away_team    String
  away_team_id Int
  home_score   Int?
  away_score   Int?
  kickoff      DateTime
  status       String   @default("SCHEDULED")
  minute       Int?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  gameweek     Gameweek           @relation(fields: [gameweek_id], references: [id])
  events       MatchEvent[]
  performances MatchPerformance[]

  @@map("matches")
}

model MatchEvent {
  id             Int      @id @default(autoincrement())
  match_id       Int
  player_id      Int?
  event_type     String
  minute         Int
  points_awarded Decimal
  detail         String?
  created_at     DateTime @default(now())

  match Match @relation(fields: [match_id], references: [id])

  @@map("match_events")
}

model MatchPerformance {
  id             Int      @id @default(autoincrement())
  match_id       Int
  player_id      Int
  minutes_played Int      @default(0)
  goals          Int      @default(0)
  assists        Int      @default(0)
  clean_sheet    Boolean  @default(false)
  yellow_cards   Int      @default(0)
  red_cards      Int      @default(0)
  own_goals      Int      @default(0)
  saves          Int      @default(0)
  penalty_saved  Boolean  @default(false)
  penalty_missed Boolean  @default(false)
  rating         Decimal?
  total_points   Decimal  @default(0)

  match  Match  @relation(fields: [match_id], references: [id])
  player Player @relation(fields: [player_id], references: [id])

  @@unique([match_id, player_id])
  @@map("match_performances")
}

model Transaction {
  id             String   @id @default(uuid())
  user_id        String
  type           String
  amount         Decimal
  credits_amount Decimal
  reference      String?
  status         String   @default("PENDING")
  description    String?
  metadata       String?
  created_at     DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@map("transactions")
}

model MarketplaceListing {
  id                String   @id @default(uuid())
  seller_id         String
  player_id         Int
  price             Decimal
  listing_type      String
  min_bid           Decimal?
  current_bid       Decimal?
  current_bidder_id String?
  expires_at        DateTime
  status            String   @default("ACTIVE")
  created_at        DateTime @default(now())

  seller User             @relation(fields: [seller_id], references: [id])
  player Player           @relation(fields: [player_id], references: [id])
  bids   MarketplaceBid[]

  @@map("marketplace_listings")
}

model MarketplaceBid {
  id         String   @id @default(uuid())
  listing_id String
  bidder_id  String
  amount     Decimal
  created_at DateTime @default(now())

  listing MarketplaceListing @relation(fields: [listing_id], references: [id])
  bidder  User               @relation(fields: [bidder_id], references: [id])

  @@map("marketplace_bids")
}

model PlayerPriceHistory {
  id          Int      @id @default(autoincrement())
  player_id   Int
  price       Decimal
  recorded_at DateTime @default(now())

  player Player @relation(fields: [player_id], references: [id])

  @@map("player_price_history")
}

model UserPowerup {
  id           Int      @id @default(autoincrement())
  user_id      String
  powerup_type String
  status       String   @default("AVAILABLE")
  gameweek_id  Int?
  purchased_at DateTime @default(now())
  used_at      DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@map("user_powerups")
}

model UserSession {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  ip_address String?
  user_agent String?
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@map("user_sessions")
}

model Achievement {
  id             Int     @id @default(autoincrement())
  code           String  @unique
  name           String
  description    String
  icon           String
  points_reward  Int     @default(0)
  credits_reward Decimal @default(0)

  @@map("achievements")
}

model UserAchievement {
  id             Int      @id @default(autoincrement())
  user_id        String
  achievement_id Int
  earned_at      DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@map("user_achievements")
}

model Duel {
  id                 String   @id @default(uuid())
  challenger_id      String
  opponent_id        String
  challenger_team_id String
  opponent_team_id   String
  gameweek_id        Int
  stake              Decimal  @default(0)
  status             String   @default("PENDING")
  challenger_tactic  String   @default("BALANCED")
  opponent_tactic    String   @default("BALANCED")
  challenger_points  Decimal  @default(0)
  opponent_points    Decimal  @default(0)
  winner_id          String?
  message            String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  challenger      User     @relation("DuelChallenger", fields: [challenger_id], references: [id])
  opponent        User     @relation("DuelOpponent",   fields: [opponent_id],   references: [id])
  gameweek        Gameweek @relation(fields: [gameweek_id], references: [id])

  @@map("duels")
}

model PrivateLeague {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique
  owner_id       String
  max_members    Int      @default(20)
  league_filter  String?
  allow_mixed    Boolean  @default(true)
  pot_amount     Decimal?
  season_id      Int?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  members  PrivateLeagueMember[]
  messages LeagueMessage[]

  @@map("private_leagues")
}

model PrivateLeagueMember {
  id                Int      @id @default(autoincrement())
  private_league_id String
  user_id           String
  team_id           String?
  joined_at         DateTime @default(now())

  private_league PrivateLeague @relation(fields: [private_league_id], references: [id])
  user           User          @relation(fields: [user_id], references: [id])

  @@unique([private_league_id, user_id])
  @@map("private_league_members")
}

model LeagueMessage {
  id                Int      @id @default(autoincrement())
  private_league_id String
  user_id           String
  message           String
  created_at        DateTime @default(now())

  private_league PrivateLeague @relation(fields: [private_league_id], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [user_id], references: [id])

  @@map("league_messages")
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    String
  type       String
  title      String
  body       String
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Sponsor {
  id            Int    @id @default(autoincrement())
  name          String
  logo          String
  weekly_income Int
  requirement   String
  tier          String
  description   String
  is_active     Boolean @default(true)

  user_sponsors UserSponsor[]

  @@map("sponsors")
}

model UserSponsor {
  id          Int      @id @default(autoincrement())
  user_id     String
  sponsor_id  Int
  started_at  DateTime @default(now())
  active      Boolean  @default(true)

  user    User    @relation(fields: [user_id], references: [id])
  sponsor Sponsor @relation(fields: [sponsor_id], references: [id])

  @@unique([user_id, sponsor_id])
  @@map("user_sponsors")
}

model ResponsibleGaming {
  id                    Int      @id @default(autoincrement())
  user_id               String   @unique
  daily_limit           Decimal?
  weekly_limit          Decimal?
  monthly_limit         Decimal?
  session_limit_minutes Int?
  self_excluded         Boolean  @default(false)
  excluded_until        DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@map("responsible_gaming")
}
